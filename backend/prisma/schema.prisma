generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  on_the_way
  delivered
  cancelled
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  name         String
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  statusChanges OrderStatusHistory[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[] @relation("ProductCategories")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String
  price           Decimal          @db.Decimal(10, 2)
  available       Boolean          @default(true)
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  categories      Category[]       @relation("ProductCategories")
  // Cuando el producto se usa como adicional de otro (categoría "Adicional").
  cartItemExtras  CartItemExtra[]
  orderItemExtras OrderItemExtra[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([available])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  openingHours String
  phone        String
  orders       Order[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

model Address {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street    String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  notes     String          @default("")
  // Ids de los adicionales elegidos, ordenados y separados por coma ("" si no eligió ninguno).
  // Junto con carrito y producto define la línea: la misma hamburguesa con otros adicionales es otra línea.
  extrasKey String          @default("")
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  extras    CartItemExtra[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, extrasKey])
  @@index([cartId])
  @@index([productId])
}

// Adicional elegido en una línea del carrito. El adicional es un producto de la categoría "Adicional".
model CartItemExtra {
  cartItemId String
  extraId    String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  extra      Product  @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@id([cartItemId, extraId])
  @@index([extraId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String?
  branchId    String
  addressId   String
  guestName   String?
  guestEmail  String?
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(10, 2)
  user        User?       @relation(fields: [userId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  address     Address     @relation(fields: [addressId], references: [id])
  items       OrderItem[]
  statusHistory OrderStatusHistory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([branchId])
  @@index([addressId])
  @@index([status])
}

model OrderItem {
  id        String           @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal          @db.Decimal(10, 2)
  notes     String           @default("")
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])
  extras    OrderItemExtra[]

  @@index([orderId])
  @@index([productId])
}

// Adicional de una línea del pedido. Nombre y precio se congelan al confirmar, como OrderItem.unitPrice.
model OrderItemExtra {
  id          String    @id @default(cuid())
  orderItemId String
  extraId     String
  name        String
  price       Decimal   @db.Decimal(10, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extra       Product   @relation(fields: [extraId], references: [id])

  @@index([orderItemId])
  @@index([extraId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedAt       DateTime    @default(now())
  changedByUserId String?
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?       @relation(fields: [changedByUserId], references: [id])

  @@index([orderId])
  @@index([changedByUserId])
}
