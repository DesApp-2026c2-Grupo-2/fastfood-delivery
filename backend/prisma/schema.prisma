// Promoción automática (sin código). Vigente: activa y, si tiene fechas, dentro de ellas. Se aplica una sola por pedido.
model Promotion {
  id        String        @id @default(cuid())
  name      String
  type      PromotionType @default(percent)
  // percent: entero de 1 a 100. two_for_one: se guarda 0; el descuento sale de las unidades del producto.
  value     Int
  // Obligatorio en el 2x1. En el porcentual queda vacío: el descuento es de todo el pedido.
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  active    Boolean       @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  // Solo en el porcentual. Si está vacío, el descuento no pide un monto mínimo.
  minSubtotal Decimal?      @db.Decimal(10, 2)
  orders    Order[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([active])
  @@index([productId])
}

model OrderItem {
  id        String           @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal          @db.Decimal(10, 2)
  notes     String           @default("")
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])
  extras    OrderItemExtra[]

  @@index([orderId])
  @@index([productId])
}

// Adicional de una línea del pedido. Nombre y precio se congelan al confirmar, como OrderItem.unitPrice.
model OrderItemExtra {
  id          String    @id @default(cuid())
  orderItemId String
  extraId     String
  name        String
  price       Decimal   @db.Decimal(10, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extra       Product   @relation(fields: [extraId], references: [id])

  @@index([orderItemId])
  @@index([extraId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedAt       DateTime    @default(now())
  changedByUserId String?
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?       @relation(fields: [changedByUserId], references: [id])

  @@index([orderId])
  @@index([changedByUserId])
}
