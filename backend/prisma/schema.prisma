// Recuperar contraseña (HU-15). Se guarda el hash del token, nunca el token. Vence y es de un solo uso.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[] @relation("ProductCategories")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String
  price           Decimal          @db.Decimal(10, 2)
  available       Boolean          @default(true)
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  categories      Category[]       @relation("ProductCategories")
  // Cuando el producto se usa como adicional de otro (categoría "Adicional").
  cartItemExtras  CartItemExtra[]
  orderItemExtras OrderItemExtra[]
  stock           Stock[]
  promotions      Promotion[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([available])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  openingHours String
  phone        String
  orders       Order[]
  stock        Stock[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// Stock de un producto en una sucursal (HU-17, HU-18). Sin fila, el producto no se vende en esa sucursal.
// Al confirmar un pedido pasa de available a reserved; al cancelarlo vuelve; al entregarlo sale de reserved.
model Stock {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  available Int      @default(0)
  reserved  Int      @default(0)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

// Parámetros del sistema editables por el admin (HU-19): radio de cobertura, constantes de ETA y precio de envío por km.
model Parameter {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nombre corto para reconocer la dirección ("Casa", "Trabajo"). Vacío si no tiene.
  alias     String   @default("")
  street    String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  notes     String          @default("")
  // Ids de los adicionales elegidos, ordenados y separados por coma ("" si no eligió ninguno).
  // Junto con carrito y producto define la línea: la misma hamburguesa con otros adicionales es otra línea.
  extrasKey String          @default("")
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  extras    CartItemExtra[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, extrasKey])
  @@index([cartId])
  @@index([productId])
}

// Adicional elegido en una línea del carrito. El adicional es un producto de la categoría "Adicional".
model CartItemExtra {
  cartItemId String
  extraId    String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  extra      Product  @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@id([cartItemId, extraId])
  @@index([extraId])
}

