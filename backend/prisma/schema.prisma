generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

// Qué puede hacer un admin. super_admin: todo el backoffice.
// orders_viewer: consulta pedidos, ve y resuelve reclamos y sus cupones. No cambia estados de pedidos.
enum AdminRole {
  super_admin
  orders_viewer
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  on_the_way
  delivered
  cancelled
}

// Cómo recibe el cliente el pedido (HU-23). En retiro no hay dirección ni traslado.
enum Fulfillment {
  delivery
  pickup
}

// Reclamo sobre un pedido entregado o retirado (HU-36).
enum IncidentReason {
  missing_item
  wrong_order
  late
  cold
  other
}

// open va primero: ordenar por estado deja las abiertas arriba.
enum IncidentStatus {
  open
  resolved
}

// Tipo de promoción (HU-20, HU-21). El porcentual descuenta el pedido; el 2x1, un producto.
enum PromotionType {
  percent
  two_for_one
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  name         String
  // Baja lógica de clientes desde el admin. Deshabilitado no inicia sesión ni usa su token; sus pedidos quedan.
  active       Boolean   @default(true)
  // Solo para role = admin; en los clientes queda vacío.
  adminRole    AdminRole?
  // Sellos de fidelización: +1 al crear un pedido que llega al mínimo; se revierte si se cancela.
  loyaltyStamps Int      @default(0)
  // Premio de un solo uso por cerrar una campaña Top 3 compradores.
  hasTopBuyerReward Boolean @default(false)
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  statusChanges OrderStatusHistory[]
  incidents     Incident[]
  passwordResetTokens PasswordResetToken[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Recuperar contraseña (HU-15). Se guarda el hash del token, nunca el token. Vence y es de un solo uso.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[] @relation("ProductCategories")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String
  price           Decimal          @db.Decimal(10, 2)
  available       Boolean          @default(true)
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  categories      Category[]       @relation("ProductCategories")
  // Cuando el producto se usa como adicional de otro (categoría "Adicional").
  cartItemExtras  CartItemExtra[]
  orderItemExtras OrderItemExtra[]
  // Adicionales que ofrece este producto, y productos que ofrecen a este como adicional (HU-30).
  offeredExtras   ProductExtra[]   @relation("ProductExtraHost")
  offeredIn       ProductExtra[]   @relation("ProductExtraOption")
  stock           Stock[]
  promotions      Promotion[]
  stockReleases   StockRelease[]
  stockWaivers    OrderStockWaiver[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([available])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Adicional que se ofrece en un producto (HU-30). Lo marca el admin. Sin filas, el producto no ofrece adicionales.
// El adicional es un producto de la categoría "Adicional".
model ProductExtra {
  productId String
  extraId   String
  product   Product @relation("ProductExtraHost", fields: [productId], references: [id], onDelete: Cascade)
  extra     Product @relation("ProductExtraOption", fields: [extraId], references: [id], onDelete: Cascade)

  @@id([productId, extraId])
  @@index([extraId])
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String
  // Opcionales: las sucursales cargadas antes de pedirlos quedan vacías.
  city         String?
  province     String?
  postalCode   String?
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  openingHours String
  // Franjas por día (0 = lunes … 6 = domingo). Si no hay ninguna, se muestra el texto openingHours.
  hours        BranchHour[]
  phone        String
  orders       Order[]
  stock        Stock[]
  stockReleases StockRelease[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// Hasta dos franjas por día (horario corrido o partido). El cierre es el mismo día.
model BranchHour {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  weekday  Int
  // 0 primera franja, 1 segunda cuando el día está partido.
  slot     Int    @default(0)
  opensAt  String
  closesAt String

  @@unique([branchId, weekday, slot])
  @@index([branchId])
}

// Stock de un producto en una sucursal (HU-17, HU-18). Sin fila, el producto no se vende en esa sucursal.
// Al confirmar un pedido pasa de available a reserved; al cancelarlo vuelve; al entregarlo sale de reserved.
// El admin puede devolver el reservado a disponible. Ese pedido no vuelve a mover esas unidades.
model Stock {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  available Int      @default(0)
  reserved  Int      @default(0)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

// El admin liberó el reservado de un producto. Sirve para frenar un carrito de invitado armado antes.
model StockRelease {
  id        String   @id @default(cuid())
  branchId  String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([branchId])
}

// Producto que un pedido ya no retiene porque el admin liberó ese reservado.
model OrderStockWaiver {
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
  @@index([productId])
}

// Parámetros del sistema editables por el admin (HU-19): radio de cobertura, constantes de ETA y precio de envío por km.
model Parameter {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Address {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nombre corto para reconocer la dirección ("Casa", "Trabajo"). Vacío si no tiene.
  alias     String   @default("")
  street    String
  // Opcionales: las direcciones cargadas antes de pedirlos quedan vacías.
  city       String?
  province   String?
  postalCode String?
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  // true si el admin liberó stock de un producto que estaba en este carrito. No se puede comprar hasta vaciarlo.
  purchaseBlocked Boolean @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  notes     String          @default("")
  // Ids de los adicionales elegidos, ordenados y separados por coma ("" si no eligió ninguno).
  // Junto con carrito y producto define la línea: la misma hamburguesa con otros adicionales es otra línea.
  extrasKey String          @default("")
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  extras    CartItemExtra[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, extrasKey])
  @@index([cartId])
  @@index([productId])
}

// Adicional elegido en una línea del carrito. El adicional es un producto de la categoría "Adicional".
model CartItemExtra {
  cartItemId String
  extraId    String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  extra      Product  @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@id([cartItemId, extraId])
  @@index([extraId])
}

model Order {
  id          String      @id @default(cuid())
  // Código para decirlo en el local: 3 letras de la sucursal + 6 dígitos. El id sigue siendo la clave.
  code        String      @unique @default(dbgenerated("generate_order_code()"))
  userId      String?
  branchId    String
  // Vacío en los pedidos de retiro (HU-23).
  addressId   String?
  fulfillment Fulfillment @default(delivery)
  guestName   String?
  guestEmail  String?
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(10, 2)
  // Hora estimada de entrega. Se calcula una vez al confirmar y no se recalcula (DEV-14).
  estimatedDeliveryAt DateTime
  // Si el pedido se confirmó con la sucursal cerrada, la preparación arranca en esta hora (la próxima apertura).
  scheduledFor DateTime?
  // true mientras el pedido tiene stock reservado en su sucursal (HU-18). Los pedidos anteriores
  // al stock quedan en false: al cancelarlos o entregarlos no se toca el stock.
  stockReserved Boolean     @default(false)
  // Productos que este pedido ya no retiene: el admin liberó ese reservado.
  stockWaivers  OrderStockWaiver[]
  // true si al crear el pedido se sumó un sello de fidelidad (para revertirlo al cancelar).
  loyaltyStampGranted Boolean @default(false)
  // true si ese sello completó la tarjeta. Sirve para mostrar la grilla llena en ese pedido.
  loyaltyCycleCompleted Boolean @default(false)
  // true si el descuento aplicado fue el premio de fidelidad, no otra promo.
  loyaltyRewardApplied Boolean @default(false)
  // Precio de lista (productos + adicionales). totalAmount es lo que se cobra: subtotal − discountAmount + deliveryFee.
  subtotal       Decimal    @db.Decimal(10, 2)
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)
  // Costo de envío según el tramo de distancia al confirmar; se congela. En retiro y en pedidos viejos, 0.
  deliveryFee    Decimal    @default(0) @db.Decimal(10, 2)
  // La promo aplicada al confirmar. El nombre se copia: editar la promo después no cambia el pedido.
  promotionId    String?
  promotionName  String?
  promotion      Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user        User?       @relation(fields: [userId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  statusHistory OrderStatusHistory[]
  incident      Incident? @relation("OrderIncident")
  // Cupón de un reclamo consumido en este pedido. Se vacía si se cancela, para que vuelva a estar disponible.
  couponIncidentId String?   @unique
  couponIncident   Incident? @relation("IncidentCoupon", fields: [couponIncidentId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([branchId])
  @@index([addressId])
  @@index([status])
  @@index([promotionId])
}

// Promoción automática (sin código). Vigente: activa y, si tiene fechas, dentro de ellas. Se aplica una sola por pedido.
model Promotion {
  id        String        @id @default(cuid())
  name      String
  type      PromotionType @default(percent)
  // percent: entero de 1 a 100. two_for_one: se guarda 0; el descuento sale de las unidades del producto.
  value     Int
  // Obligatorio en el 2x1. En el porcentual queda vacío: el descuento es de todo el pedido.
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  active    Boolean       @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  // Solo en el porcentual. Si está vacío, el descuento no pide un monto mínimo.
  minSubtotal Decimal?      @db.Decimal(10, 2)
  orders    Order[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([active])
  @@index([productId])
}

model OrderItem {
  id        String           @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal          @db.Decimal(10, 2)
  notes     String           @default("")
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product          @relation(fields: [productId], references: [id])
  extras    OrderItemExtra[]

  @@index([orderId])
  @@index([productId])
}

// Adicional de una línea del pedido. Nombre y precio se congelan al confirmar, como OrderItem.unitPrice.
model OrderItemExtra {
  id          String    @id @default(cuid())
  orderItemId String
  extraId     String
  name        String
  price       Decimal   @db.Decimal(10, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extra       Product   @relation(fields: [extraId], references: [id])

  @@index([orderItemId])
  @@index([extraId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedAt       DateTime    @default(now())
  changedByUserId String?
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User?       @relation(fields: [changedByUserId], references: [id])

  @@index([orderId])
  @@index([changedByUserId])
}

// Un reclamo por pedido (orderId único). Solo lo puede crear el dueño de un pedido entregado o retirado.
// Al resolverlo, el admin deja una respuesta y, si quiere, un cupón de un monto fijo solo para ese cliente.
model Incident {
  id           String         @id @default(cuid())
  orderId      String         @unique
  userId       String
  reason       IncidentReason
  message      String         @default("")
  status       IncidentStatus @default(open)
  response     String         @default("")
  // Vacío si la solución no incluye cupón. El código es de un solo uso, exclusivo del userId y vence a los 3 meses.
  couponCode      String?   @unique
  couponAmount    Decimal?  @db.Decimal(10, 2)
  couponCreatedAt DateTime?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  // Cuándo el cliente abrió el pedido después de la solución. Vacío si todavía no la vio.
  responseSeenAt DateTime?
  order        Order          @relation("OrderIncident", fields: [orderId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])
  redeemedOrder Order?        @relation("IncidentCoupon")

  @@index([status])
  @@index([userId])
}