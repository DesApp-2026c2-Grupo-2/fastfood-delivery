generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

// Qué puede hacer un admin. super_admin: todo el backoffice. orders_viewer: solo consultar pedidos.
enum AdminRole {
  super_admin
  orders_viewer
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  on_the_way
  delivered
  cancelled
}

// Cómo recibe el cliente el pedido (HU-23). En retiro no hay dirección ni traslado.
enum Fulfillment {
  delivery
  pickup
}

// Tipo de promoción (HU-20, HU-21). El porcentual descuenta el pedido; el 2x1, un producto.
enum PromotionType {
  percent
  two_for_one
}

